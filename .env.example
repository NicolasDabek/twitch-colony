# ─── Twitch Colony : configuration ───────────────────────────────
# Copiez ce fichier en .env (jamais commité) puis remplissez-le.
# Voir README, section « Configurer Twitch ».

# Mode de jeu : "sim" (simulateur local, aucune valeur Twitch requise) ou "twitch" (chat réel)
MODE=sim

# Port HTTP local de l'overlay (http://localhost:PORT/overlay.html)
PORT=3000

# Nom de votre chaîne Twitch (login en minuscules, sans #). Ex. nicolasdabek
TWITCH_CHANNEL=

# Compte qui se connecte au chat : votre chaîne ou un compte bot dédié
TWITCH_BOT_USERNAME=

# 🔒 Jeton d'accès utilisateur du compte bot, « oauth:xxxx » ou brut (le préfixe est ajouté seul)
# Scopes requis : chat:read chat:edit bits:read channel:read:subscriptions
TWITCH_OAUTH_TOKEN=

# Identifiant de l'application créée sur https://dev.twitch.tv/console/apps (pas secret)
TWITCH_CLIENT_ID=

# 🔒 Secret de l'application (facultatif, sert au renouvellement automatique du jeton)
TWITCH_CLIENT_SECRET=

# 🔒 Jeton de renouvellement (facultatif, avec CLIENT_ID + CLIENT_SECRET : renouvellement automatique)
TWITCH_REFRESH_TOKEN=

# 🔒 Secret EventSub (futur webhook Bits/subs), 10 à 100 caractères aléatoires. Facultatif pour l'instant.
TWITCH_EVENTSUB_SECRET=

# ─── Réglages de jeu (facultatifs) ───────────────────────────────
# Délai entre deux commandes identiques d'un même viewer (secondes)
COMMAND_COOLDOWN_SECONDS=5
# Durée d'un vote (secondes)
VOTE_DURATION_SECONDS=30
# Intervalle entre deux votes automatiques (secondes, 0 = désactivé)
AUTO_VOTE_INTERVAL_SECONDS=180
